# cp .env.example .env — then ./scripts/install.sh (or npm start) picks it up.
# Everything is optional, uncomment what you want to change.

# Apple Music storefront for artwork & links (two-letter country code)
# MUSIC_RPC_COUNTRY=de

# Up to two of: apple, spotify, youtube — or none
# MUSIC_RPC_BUTTONS=apple,spotify

# Keep the presence while paused (without the progress bar)
# MUSIC_RPC_SHOW_PAUSED=false

# Upload local artwork to litterbox.catbox.moe (deleted after 1h)
# when the track isn't in the Apple Music catalog
# MUSIC_RPC_UPLOAD_ARTWORK=true

# Poll interval in ms while Music is open / while Music or Discord is closed
# MUSIC_RPC_POLL_MS=5000
# MUSIC_RPC_IDLE_MS=15000

# Your own Discord application id (the name shows in "Listening to …")
# MUSIC_RPC_CLIENT_ID=

# Force "music" or "itunes" instead of detecting it from the macOS version
# MUSIC_RPC_APP=

# Verbose logging
# MUSIC_RPC_DEBUG=false
